{
  "name": "jomform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:unit && next build && npm run docs:facts && npm run css:scan-scope",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "node scripts/web-deps-check.mjs && node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/*.test.ts",
    "docs:facts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/docsFacts.mjs",
    "css:scan-scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cssScanScope.mjs",
    "a11y": "playwright test --project=a11y",
    "e2e": "playwright test --project=feature-e2e",
    "a11y:install": "playwright install chromium"
  },
  "dependencies": {
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
