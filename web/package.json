{
  "name": "jomform-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23.0.0 || >=23.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run og:image",
    "prebuild": "npm run og:image",
    "build": "npm run test:unit && next build && npm run docs:facts && npm run css:scan-scope",
    "og:image": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/og-image-version.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "node scripts/web-deps-check.mjs && node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/*.test.ts",
    "docs:facts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/docsFacts.mjs",
    "guides:sync": "node scripts/guides.mjs",
    "guides:check": "node scripts/guides.mjs --check",
    "css:scan-scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cssScanScope.mjs",
    "a11y": "playwright test --project=a11y",
    "e2e": "playwright test --project=feature-e2e",
    "audit:gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/npm-audit-gate.mjs",
    "a11y:install": "playwright install chromium"
  },
  "dependencies": {
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
