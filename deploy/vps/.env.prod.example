# ════════════════════════════════════════════════════════════════════════════
# JomForm PRODUCTION env contract — the companion of deploy/vps/compose.prod.yml
#
# A TEMPLATE, NOT A CREDENTIAL. The secrets below ship EMPTY on purpose: an
# unfilled copy must fail loudly instead of running with a placeholder that looks
# like a key. ENCRYPTION_KEY / POSTGRES_PASSWORD have no usable default — the
# stack refuses to come up without them.
#
#   cp deploy/vps/.env.prod.example ~/jomform.env
#   chmod 600 ~/jomform.env          # bootstrap-host.sh REFUSES a world-readable file
#   $EDITOR ~/jomform.env            # fill the ACCOUNT values (see the classes below)
#   deploy/host/bootstrap-host.sh --env-file ~/jomform.env            # plan
#   sudo deploy/host/bootstrap-host.sh --env-file ~/jomform.env --apply
#
# THE KEY SET IS DERIVED FROM THE COMPOSE, NOT MAINTAINED HERE. It is exactly the
# set of ${KEY} interpolations in deploy/vps/compose.prod.yml, and the `host`
# gate fails in BOTH directions: a key the compose reads that this file lacks,
# and a key this file carries that the compose does not read. Re-derive it with:
#
#   grep -oE '\$\{[A-Z_]+' deploy/vps/compose.prod.yml | tr -d '${' | sort -u
#
# TWO CLASSES OF SECRET. Which one a key is decides what a NEW HOST does with it,
# and getting it wrong is the expensive mistake this file exists to prevent:
#
#   ACCOUNT — issued elsewhere, or encrypts data AT REST. INHERIT it from the
#             current host (cp /opt/jomform/.env, or the password manager).
#             Regenerating one makes stored data UNREADABLE (ENCRYPTION_KEY) or
#             breaks an integration (every provider client below).
#   HOST    — the database and the object store are REBUILT from the nightly
#             backup, not copied, so these may be minted fresh:
#             openssl rand -hex 32
# ════════════════════════════════════════════════════════════════════════════

# ── HOST secrets — mint on the new host, do not carry over ───────────────────
# The database password. The api's DATABASE_URL interpolates this same value, so
# it is written once. postgres refuses to initialise while it is empty.
POSTGRES_PASSWORD=
# The object store's S3 credentials (SeaweedFS reads them as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY; the api reads the same two values as S3_ACCESS_KEY /
# S3_SECRET_KEY, so the two sides cannot drift). The access key is an identity,
# not a secret — production uses `jomform`; the secret is minted with
# `openssl rand -hex 32`. Both are REQUIRED and fail closed: a host whose file
# still carries only the old MinIO key refuses to start rather than coming up
# with empty credentials. An existing host migrating off MinIO: add these two
# lines with the values the new store is initialised with (see
# deploy/HOST-SETUP.md § "Moving production off MinIO").
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── ACCOUNT secrets — INHERIT from the current host ─────────────────────────
# 64 hex chars (32 bytes) — a different length is refused at startup, and a value
# is required outside dev. It encrypts per-account CHIP keys and stored
# credentials IN THE DATABASE: a new value does not rotate them, it makes them
# unreadable, and the rows then look like corruption. Restoring the database
# without this exact value is the one mistake a migration cannot undo.
ENCRYPTION_KEY=

# ── Transactional email (AWS SES, SMTP interface) — ACCOUNT, inherit ─────────
# The API reads SES_*, NOT SMTP_*: a file with SMTP_* names is a deployment that
# sends no email at all. Empty SMTP host/user/pass is the silent half of a bad
# migration — verifications, password resets and deliveries just never arrive
# and nothing at startup complains.
SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SES_SMTP_PORT=587
# SES SMTP credentials — IAM, NOT the AWS secret access key.
SES_SMTP_USER=
SES_SMTP_PASS=
# The From address; must be a verified identity (or domain identity) in SES.
SES_FROM=noreply@jomform.com
# The switch that makes the API consume Bounce/Complaint events: with
# SES_SNS_NOTIF_ENABLED=true the server registers /v1/internal/ses/notifications
# and feeds the suppression list, so a hard-bounced address stops being mailed.
# false/empty leaves the endpoint unregistered (nothing to subscribe an SNS topic
# to). The configuration SET itself is AWS-side wiring, not a key here: the
# sending identity carries it, and the API never reads its name.
SES_SNS_NOTIF_ENABLED=true

# ── Cloudflare OAuth client (custom-domain auto-setup) — ACCOUNT, inherit ────
# Used for the dashboard flow that creates a custom domain's CNAME. An empty
# CLIENT_ID means that flow reports itself not configured and the operator adds
# the DNS record by hand.
#
# The CLIENT_ID alone switches the flow on. Whether the SECRET belongs here is
# decided by how the OAuth client is registered in Cloudflare (its
# token_endpoint_auth_method), not by this file:
#   * public client, PKCE ("none") — what JomForm registers, so the production
#     deployment leaves the secret EMPTY. The code exchange authenticates with
#     the PKCE code_verifier, and a client secret presented by such a client is
#     REFUSED (invalid_client), so filling this in breaks the flow it is meant
#     to configure. Measured against Cloudflare's token endpoint: production's
#     client id with no secret reaches code validation (invalid_grant for a fake
#     code), while the same request carrying any client_secret answers
#     invalid_client.
#   * confidential client ("client_secret_post") — set the secret; the API sends
#     it with the code exchange and with the refresh.
JF_CF_OAUTH_CLIENT_ID=
JF_CF_OAUTH_CLIENT_SECRET=

# ── CDN edge invalidation for a media purge — OPTIONAL, empty = feature off ──
# Without these, a purged media object keeps being served from Cloudflare's edge
# until its freshness lifetime (bounded to 300s) expires; with them the purge
# asks the CDN to drop the object's URLs in the SAME request and names what
# happened in the response (`edge`). The token needs Zone → Cache Purge on the
# zone the public media URLs live in. Measure it with
# scripts/media-purge-probe.sh — it probes the origin AND the edge.
#
# The same credentials also drop a form's share card (/og/{slug}.png) when the
# form stops being live. That card is served on a PER-WORKSPACE host, so list a
# wildcard for the tenant subdomains; an exact host list silently reports
# `edge: out_of_zone` and clears nothing:
#   JF_CF_PURGE_HOSTS=*.jomform.com,<your verified custom domains>
JF_CF_PURGE_TOKEN=
JF_CF_PURGE_ZONE_ID=
# Optional comma-separated list of the hosts in that zone; empty defaults to the
# host of S3_PUBLIC_BASE / APP_BASE_URL. "*.example.com" matches any subdomain.
JF_CF_PURGE_HOSTS=

# ── Google sign-in — ACCOUNT, inherit; empty = the button is not offered ─────
JF_GOOGLE_CLIENT_ID=
JF_GOOGLE_CLIENT_SECRET=

# ── Ollama Cloud credential — ACCOUNT, inherit ──────────────────────────────
# Powers EVERY AI surface: the in-app assistant, the AI form builder, legal-page
# drafts, the spam judge and the code-asset scan. Empty = those features report
# themselves unavailable rather than offering a control that always errors.
# LLM_BASE_URL / LLM_MODEL are optional overrides; these are the defaults (and
# what production runs).
OLLAMA_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=deepseek-v4.1-flash:1017
# The spam judge's own decision seam. It asks the provider's /v1/systemone route
# (same base URL and key as chat) with this model, and flags a submission when
# the answer's noul confidence is >= the threshold. clef is the id GET /v1/models
# publishes with "api":"systemone" — do not point this at LLM_MODEL.
SPAM_JUDGE_MODEL=clef
SPAM_JUDGE_THRESHOLD=0.5

# ── Site super-admins — ACCOUNT, inherit ────────────────────────────────────
# Comma-separated email allowlist (issue #385). A logged-in user whose address
# matches gets the platform-wide monitoring and admin tools; empty = no
# super-admins, so nobody can reach them.
SUPER_ADMIN_EMAILS=

# ────────────────────────────────────────────────────────────────────────────
# NOT HERE, ON PURPOSE: DATABASE_URL, VALKEY_URL, S3_ENDPOINT,
# S3_BUCKET, S3_REGION, APP_BASE_URL, APP_ENV and
# PORT are set as LITERALS in deploy/vps/compose.prod.yml — the compose builds
# them from the values above (DATABASE_URL interpolates POSTGRES_PASSWORD), so
# they are not part of the interpolation contract this file mirrors.
