# JomForm environment — the contract `deploy/docker-compose.yml` reads.
#
# DO NOT EDIT THIS FILE. Copy it, then let the bootstrap fill the secrets in:
#
#     bash deploy/selfhost/bootstrap.sh --base-url https://forms.example.com
#
# That copies this file to deploy/.env, replaces every `change_me_*` below with
# `openssl rand -hex 32`, refuses to run while a placeholder is left, and starts
# the stack. Keep deploy/.env: it holds the key that encrypts merchant payment
# credentials and signs verification links, so losing it is losing that data.
# chmod 600 it.
#
# Every key here is read by the compose AND by the API. A key the API does not
# read is a credential somebody protects for nothing — two of those
# (SESSION_SECRET, SMTP_*) were removed for exactly that reason.

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=jomform
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=jomform

# ── object storage (S3-compatible) ──────────────────────────────────────────
# The stack ships SeaweedFS as its S3 server and the API authenticates to it with
# the pair below; the bucket is created by the API at startup, so there is
# nothing to run by hand. To use a DIFFERENT S3 (AWS, R2, Ceph, an existing
# MinIO), change S3_ENDPOINT in deploy/docker-compose.yml and point these three
# at it — the addressing rule is path-style for any custom endpoint, which every
# S3-compatible server but AWS accepts.
S3_ACCESS_KEY=jomform
S3_SECRET_KEY=change_me_s3_secret_key
S3_BUCKET=jomform-media
S3_REGION=us-east-1
# Browser-reachable base for uploaded media (issue #145). Empty = the API uses
# {APP_BASE_URL}/media, which is its own media route — the default, and the one
# to keep unless you front media with a CDN. Do NOT point this at the internal
# MinIO endpoint: the browser cannot reach `minio:9000`.
S3_PUBLIC_BASE=

# ── this deployment's identity ──────────────────────────────────────────────
# 32 bytes as hex (64 characters). Encrypts per-account payment credentials at
# rest and signs email-verification links. Generate it ONCE and keep it: a new
# key makes previously stored credentials unreadable.
ENCRYPTION_KEY=change_me_encryption_key

# The public origin users load. This is ALSO the passkey (WebAuthn) relying
# party: its HOST becomes the RP ID every ceremony is bound to, and a browser
# refuses an RP ID that is not equal to (or a domain suffix of) the page's own
# origin — so a deployment that serves a different host than this value sets
# cannot register or sign in with a passkey. Use the real public origin,
# including the scheme and any non-default port:
#     https://forms.example.com
#     http://localhost:8080        (local trial only)
APP_BASE_URL=change_me_public_origin

# dev | prod. `prod` turns on Secure (https-only) session cookies. The bootstrap
# derives this from APP_BASE_URL: https -> prod, http -> dev (a Secure cookie is
# never sent back over plain HTTP, so a login on an http:// origin would appear
# to succeed and then be forgotten).
APP_ENV=prod

# ── the front door (Caddy, in this compose) ─────────────────────────────────
# SITE_ADDRESS is APP_BASE_URL without its port, because Caddy listens on 80/443
# INSIDE the container and HTTP_PORT/HTTPS_PORT are what the host publishes.
#     https://forms.example.com  -> SITE_ADDRESS=https://forms.example.com
#     http://localhost:8080      -> SITE_ADDRESS=http://localhost  HTTP_PORT=8080
# An https:// address makes Caddy fetch and renew a Let's Encrypt certificate for
# the hostname by itself (DNS must point here, port 80 reachable). The bootstrap
# fills all three in from APP_BASE_URL — do not hand-edit them.
SITE_ADDRESS=change_me_site_address
HTTP_PORT=80
HTTPS_PORT=443

# ── email (optional) ────────────────────────────────────────────────────────
# The sender is the AWS SES API (not a plain SMTP relay), so these are SES SMTP
# credentials plus a verified From identity. Leave them empty and the email
# features report themselves unavailable instead of half-working.
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM=
SES_REGION=ap-southeast-1
# Monitored mailbox a recipient's Reply must reach. Empty = no Reply-To header.
SES_REPLY_TO=

# Account signup is email-verified, and with no email sender there is nothing to
# mail the confirmation link to — the first account would be unusable. With this
# set to 1 the API writes that link to its own log instead:
#
#     docker compose logs api | grep -o 'http[^ ]*/v1/auth/verify?token=[^ "]*'
#
# The link is a 24-hour account-activation token, which is why this is opt-in and
# is IGNORED whenever SES_* can actually send. Set it to 0 once email works.
JOMFORM_LOG_VERIFY_LINK=1

# This deployment IS a self-hosted install: one public origin for everyone, with
# no tenant subdomains and no custom domains. That is what lets the API serve
# your published forms at {APP_BASE_URL}/f/<slug> (a slug two workspaces both
# hold stays a 404 rather than a guess).
#
# Keep it at 1 here. The HOSTED product never sets it, because its APP_BASE_URL
# is the shared product apex, which must serve no form at all (issue #77) —
# which is also why the API's default is OFF and not "the request host is my
# own origin". Set it to 0 on a deployment whose origin is shared between
# tenants.
JOMFORM_SELF_HOSTED=1

# ── AI surfaces (optional) ──────────────────────────────────────────────────
# Powers the in-app assistant, the AI form builder, legal-page drafts and the
# spam judge. Empty = those features say they are unavailable rather than
# offering a control whose every message fails.
OLLAMA_API_KEY=
# Optional overrides (defaults: https://ollama.com/v1 and deepseek-v4.1-flash:1017).
LLM_BASE_URL=
LLM_MODEL=
# The spam judge's own decision seam, on the same base URL and key.
SPAM_JUDGE_MODEL=
SPAM_JUDGE_THRESHOLD=

# ── site administration (optional) ──────────────────────────────────────────
# Comma-separated super-admin allowlist. Empty = no super admin.
SUPER_ADMIN_EMAILS=

# ── origin auto-TLS for per-tenant custom domains (optional) ────────────────
# Caddy already terminates TLS for this install's own hostname. These only
# matter if merchants point their own domains straight at the API (issue #212).
ACME_EMAIL=
