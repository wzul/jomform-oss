# JomForm environment (copy to .env and edit)
# Tip: generate secrets with `openssl rand -hex 32`

POSTGRES_USER=jomform
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=jomform

SESSION_SECRET=change_me_session_64_hex_chars
ENCRYPTION_KEY=change_me_encryption_64_hex_chars

APP_BASE_URL=http://localhost:8080
# APP_BASE_URL is also the passkey (WebAuthn) relying party: its HOST becomes the
# RP ID every ceremony is bound to, and a browser refuses an RP ID that is not
# equal to (or a domain suffix of) the page's own origin. A deployment that serves
# a different host than this value sets can therefore not register or sign in with
# a passkey — set it to the public origin of THIS deployment, including staging
# (e.g. https://jomform-staging.example.com), not to the production domain.

# Object storage
MINIO_ROOT_USER=jomform
MINIO_ROOT_PASSWORD=change_me_minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=jomform-media
S3_REGION=us-east-1
# Browser-reachable base for uploaded media (issue #145). Must point at the
# public media route, NOT the internal S3 endpoint. Defaults to {APP_BASE_URL}/media.
S3_PUBLIC_BASE=https://jomform.com/media

# Payment gateway (CHIP) — per-account keys live in DB (encrypted); nothing global
# NOTE (2026-10-12): the API does NOT read SMTP_* — it reads SES_SMTP_HOST,
# SES_SMTP_PORT, SES_SMTP_USER, SES_SMTP_PASS and SES_FROM
# (api/internal/config/config.go), so the names below are inert. They are left as
# they are because this file pairs with the DEV compose; the PRODUCTION contract,
# derived from the prod compose itself, is deploy/vps/.env.prod.example.
# smtp (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JomForm <no-reply@jomform.com>"

# Ollama Cloud credential — powers EVERY AI surface: the in-app assistant, the
# AI form builder, legal-page drafts, the spam judge and the code-asset scan.
# Leave it empty and those features report themselves unavailable rather than
# offering a control that always errors. LLM_BASE_URL / LLM_MODEL are optional
# overrides (defaults: https://ollama.com/v1 and deepseek-v4.1-flash).
OLLAMA_API_KEY=