# JomForm environment (copy to .env and edit)
# Tip: generate secrets with `openssl rand -hex 32`

POSTGRES_USER=jomform
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=jomform

SESSION_SECRET=change_me_session_64_hex_chars
ENCRYPTION_KEY=change_me_encryption_64_hex_chars

APP_BASE_URL=http://localhost:8080

# Object storage
MINIO_ROOT_USER=jomform
MINIO_ROOT_PASSWORD=change_me_minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=jomform-media
S3_REGION=us-east-1

# Payment gateway (CHIP) — per-account keys live in DB (encrypted); nothing global
# smtp (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JomForm <no-reply@jomform.com>"