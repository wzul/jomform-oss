# JomForm watchdog configuration.
#
# Install as /etc/jomform-watch.env, chmod 600, root-owned. It is sourced by
# jomform-watch.sh; every key has a built-in default, so only the ones you need
# to change (and the credentials) have to appear here.

# ── delivery (REQUIRED — the script refuses to run without a notifier) ──────
# Telegram bot token and one or more chat ids (comma-separated).
JF_WATCH_TELEGRAM_TOKEN=
JF_WATCH_TELEGRAM_CHAT=

# ── what to watch ──────────────────────────────────────────────────────────
# JF_WATCH_WEB_URL=https://jomform.com/
# JF_WATCH_WEB_MARKER=/_next/static/
# JF_WATCH_HEALTH_URL=https://jomform.com/healthz
# JF_WATCH_HEALTH_MARKER=service

# The prod host, reached over ssh for /readyz (database + valkey) and df.
# JF_WATCH_SSH_TARGET=root@203.0.113.10
# JF_WATCH_COMPOSE_FILE=/opt/jomform/compose.yml

# ── the Kanban board check ─────────────────────────────────────────────────
# On an AGENT host, set JF_WATCH_KANBAN_DB to that host's board DB so a host
# fault that kills workers shows up as a page instead of as N individually
# "broken" cards. `auto` (the default) probes the two usual paths and does
# nothing where neither exists, so the same script is safe on the prod host.
#
#   JF_WATCH_KANBAN_DB=auto                                        (default)
#   JF_WATCH_KANBAN_DB=/root/.hermes/kanban/boards/jomform/kanban.db
#   JF_WATCH_KANBAN_DB=off              # disable explicitly
#
# It alerts when `task_runs` rows ending crashed/gave_up/spawn_failed inside the
# trailing window reach the threshold. The detail names how many distinct CARDS
# and LANES are hit, how many the dispatcher itself attributed to the host
# (`infra=`), and how many died on the `ModuleNotFoundError` spawn signature —
# so the alert says "this is the host" instead of leaving it to be inferred.
# JF_WATCH_KANBAN_WINDOW_SECONDS=3600
# JF_WATCH_KANBAN_THRESHOLD=3

# ── disk ───────────────────────────────────────────────────────────────────
# JF_WATCH_DISK_MAX=85
# JF_WATCH_DISK_PATHS=/

# ── stale temp API keys (check 6) ──────────────────────────────────────────
# A QA/deploy lane mints a temporary `readwrite` key (`qa-verify-tmp*` /
# `deploy-verify-tmp*`) and is supposed to hard-delete its row. A run that dies
# before the cleanup leaves a LIVE credential behind, because the app's own
# DELETE only soft-revokes (`revoked_at=now()`) and auth is a per-request lookup
# filtered on `revoked_at IS NULL`. This check pages when such a key is older
# than the window and still live, naming the row. A key younger than the window
# (an in-flight run), a soft-revoked row, and the long-lived `AI Agent Key` rows
# are deliberately not alerted.
# JF_WATCH_TMPKEY_MAX_AGE_HOURS=24
# The prod database, reached through the same ssh target as df.
# JF_WATCH_PG_CONTAINER=jomform-postgres-1
# JF_WATCH_PG_USER=jomform
# JF_WATCH_PG_DB=jomform

# ── noise / behaviour ──────────────────────────────────────────────────────
# Re-alert every 30 minutes while a check stays down; 3 probe attempts per run.
# JF_WATCH_REALERT_SECONDS=1800
# JF_WATCH_ATTEMPTS=3
# JF_WATCH_ATTEMPT_DELAY=5
# JF_WATCH_TIMEOUT=15
# JF_WATCH_STATE_DIR=/var/lib/jomform-watch
# JF_WATCH_LOG_FILE=/var/log/jomform-watch.log
# JF_WATCH_LOG_MAX_BYTES=1048576
