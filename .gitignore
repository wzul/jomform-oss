# Binaries
/api/bin/
/dist/

# Go
*.test
*.out
coverage.txt

# Node
node_modules/
.next/
out/
# TypeScript incremental build state (`incremental: true` in web/tsconfig.json).
# It is a machine-generated output: `next build` / `tsc` rewrite it on every
# run, so a tracked copy dirties the tree on every gate run and conflicts with
# no semantic content. Ignored by pattern, not by the single web/tsconfig.tsbuildinfo
# path, so a second one (e.g. a future tsconfig at another path) cannot ride in.
*.tsbuildinfo

# Playwright (issue #99 E2E)
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
# Playwright (issue #104 a11y scan)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Env & secrets
.env
.env.*
!.env.example
# The PRODUCTION env contract for deploy/vps/compose.prod.yml. It ships on
# purpose: the fresh-host runbook tells the operator to `cp` it, and the `host`
# gate fails if its key set stops matching the compose. It holds placeholders
# only, never a working secret — the `.env.*` rule above would otherwise silence
# the whole thing (a gitignored template is not a template).
!deploy/vps/.env.prod.example
*.pem
*.key

# Data (local dev volumes)
deploy/data/
*.sql.gz

# Load-test baseline run artifacts
loadtest/results/

# IDE / OS
.idea/
.vscode/
.DS_Store